# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
#
# Generate the two secrets below with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # SECRET_KEY
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  # TOKEN_ENCRYPTION_KEY
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
APP_TIMEZONE=UTC                 # your local tz, e.g. Africa/Lagos — drives posting-time analysis

# --- Security ---------------------------------------------------------------
# SECRET_KEY signs session cookies. Rotating it logs everyone out.
SECRET_KEY=CHANGE_ME_generate_with_token_urlsafe_64

# TOKEN_ENCRYPTION_KEY encrypts X OAuth tokens at rest (AES-256-GCM).
# Must be exactly 32 bytes, base64url-encoded. LOSING THIS MEANS RECONNECTING X.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_generate_with_32_random_bytes_b64url

SESSION_TTL_HOURS=24
COOKIE_SECURE=false              # MUST be true in production (HTTPS only)
COOKIE_DOMAIN=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=xagent
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
POSTGRES_DB=xagent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- CORS -------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

# --- X / Twitter API --------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/x/oauth/callback

# Billing mode drives the cost governor. "pay_per_use" is the default and the
# only option for developer accounts created after Feb 2026.
X_BILLING_MODE=pay_per_use       # pay_per_use | legacy_subscription

# Hard ceiling on X API spend per calendar month, in USD.
# The collector degrades (daily -> freeze-only -> halt) rather than overspending.
X_MONTHLY_BUDGET_USD=25.00

# X host names. Configurable because X has renamed hosts before
# (twitter.com -> x.com); a host change should be an env edit, not a code change.
X_API_BASE_URL=https://api.x.com
X_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_TOKEN_URL=https://api.x.com/2/oauth2/token
X_REVOKE_URL=https://api.x.com/2/oauth2/revoke

# Pay-per-use rates in micro-USD (1e-6 USD) per resource. Integers on purpose:
# money is never a float in this project.
#   Owned Reads (own app reading own data): $0.001 -> 1000
#   General reads:                          $0.005 -> 5000
# Confirm against your developer dashboard — these are rates, not constants.
X_COST_OWNED_READ_MICROS=1000
X_COST_GENERAL_READ_MICROS=5000
# X documents read pricing in detail and post creation far less clearly, so the
# write rate is a setting defaulting to zero rather than a guess baked into the
# ledger. Set it from your invoice if writes turn out to be billed.
X_COST_WRITE_MICROS=0

# How long a pending OAuth authorization stays valid.
X_OAUTH_STATE_TTL_SECONDS=600

# Safety flag for decision 4 in the architecture doc. Leave FALSE until you
# have reviewed the approval queue. When false, tweet.write is never requested
# and the agent physically cannot publish.
X_ENABLE_WRITE_ACTIONS=false

# --- Anthropic (the agent's reasoning) --------------------------------------
# Without a key the agent still collects, analyses, verifies and reports — runs
# just finish as PARTIAL with no new insights. Nothing crashes and nothing is
# invented to fill the gap.
ANTHROPIC_API_KEY=
# Deep model: the daily reasoning pass. Fast model: topic classification, which
# is high-volume and much easier.
ANTHROPIC_MODEL_DEEP=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-sonnet-5

# --- Alerts and reports -----------------------------------------------------
# Email is off unless SMTP_HOST, ALERT_EMAIL_FROM and ALERT_EMAIL_TO are all
# set. With it off, alerts and reports are still generated and readable in the
# dashboard, and the delivery log records them as SKIPPED rather than FAILED —
# nothing has gone wrong when you simply have not configured SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Frontend ---------------------------------------------------------------
# Server-side only. The browser never talks to FastAPI directly, so no X or
# Anthropic credential is ever exposed to client bundles.
BACKEND_INTERNAL_URL=http://backend:8000
