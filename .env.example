# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
#
# Generate the two secrets below with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # SECRET_KEY
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  # TOKEN_ENCRYPTION_KEY
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
APP_TIMEZONE=UTC                 # your local tz, e.g. Africa/Lagos — drives posting-time analysis

# --- Security ---------------------------------------------------------------
# SECRET_KEY signs session cookies. Rotating it logs everyone out.
SECRET_KEY=CHANGE_ME_generate_with_token_urlsafe_64

# TOKEN_ENCRYPTION_KEY encrypts X OAuth tokens at rest (AES-256-GCM).
# Must be exactly 32 bytes, base64url-encoded. LOSING THIS MEANS RECONNECTING X.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_generate_with_32_random_bytes_b64url

SESSION_TTL_HOURS=24
COOKIE_SECURE=false              # MUST be true in production (HTTPS only)
COOKIE_DOMAIN=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=xagent
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
POSTGRES_DB=xagent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- CORS -------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

# --- X / Twitter API (used from Phase 3; leave blank for Phase 2) -----------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/x/oauth/callback

# Billing mode drives the cost governor. "pay_per_use" is the default and the
# only option for developer accounts created after Feb 2026.
X_BILLING_MODE=pay_per_use       # pay_per_use | legacy_subscription

# Hard ceiling on X API spend per calendar month, in USD.
# The collector degrades (daily -> freeze-only -> halt) rather than overspending.
X_MONTHLY_BUDGET_USD=25.00

# Safety flag for decision 4 in the architecture doc. Leave FALSE until you
# have reviewed the approval queue. When false, tweet.write is never requested
# and the agent physically cannot publish.
X_ENABLE_WRITE_ACTIONS=false

# --- Anthropic (used from Phase 6; leave blank for Phase 2) -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEEP=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-sonnet-5

# --- Frontend ---------------------------------------------------------------
# Server-side only. The browser never talks to FastAPI directly, so no X or
# Anthropic credential is ever exposed to client bundles.
BACKEND_INTERNAL_URL=http://backend:8000
